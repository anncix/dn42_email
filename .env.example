# LightMail 环境配置
# 复制为 .env 后修改

# 基本配置
LIGHTMAIL_DOMAIN=yourdomain.dn42
LIGHTMAIL_SECRET=change-me-to-a-random-string
LIGHTMAIL_DB=./data/lightmail.db

# SMTP 配置
LIGHTMAIL_SMTP_HOST=127.0.0.1
LIGHTMAIL_SMTP_PORT=587

# IMAP 配置
LIGHTMAIL_IMAP_HOST=127.0.0.1
LIGHTMAIL_IMAP_PORT=143

# DN42 配置
LIGHTMAIL_DN42=1
LIGHTMAIL_DN42_IPV4=172.20.xx.xx

# 公网互通
LIGHTMAIL_PUBLIC=0

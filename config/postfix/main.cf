# LightMail Postfix 配置模板
# 支持 DN42 + 公网双栈

# ============================================================
# 基本配置
# ============================================================
smtpd_banner = $myhostname ESMTP LightMail
biff = no
append_dot_mydomain = no
readme_directory = no

# ============================================================
# 网络配置
# ============================================================
# 同时监听本地、DN42、公网地址
# 根据实际情况修改
inet_interfaces = 127.0.0.1, 172.20.xx.xx
inet_protocols = ipv4, ipv6

myhostname = mail.yourdomain.dn42
mydomain = yourdomain.dn42
myorigin = $mydomain

# 目标域名
mydestination = localhost, $myhostname, $mydomain

# 信任网络
mynetworks = 127.0.0.0/8, 172.20.0.0/14, 10.0.0.0/8, [::1]/128, [fc00::]/7, [fd00::]/8

# ============================================================
# 邮箱存储（虚拟邮箱）
# ============================================================
virtual_mailbox_domains = yourdomain.dn42
virtual_mailbox_base = /var/mail/vmail
virtual_mailbox_maps = hash:/etc/postfix/vmailbox
virtual_uid_maps = static:5000
virtual_gid_maps = static:5000
virtual_alias_maps = hash:/etc/postfix/virtual

# ============================================================
# 安全配置
# ============================================================
# TLS
smtpd_tls_cert_file = /etc/ssl/certs/mail.yourdomain.dn42.crt
smtpd_tls_key_file = /etc/ssl/private/mail.yourdomain.dn42.key
smtpd_use_tls = yes
smtp_tls_CAfile = /etc/ssl/certs/dn42-root-ca.pem
smtp_tls_security_level = may
smtpd_tls_security_level = may

# SASL 认证（Dovecot）
smtpd_sasl_type = dovecot
smtpd_sasl_path = private/auth
smtpd_sasl_auth_enable = yes
smtpd_sasl_security_options = noanonymous
broken_sasl_auth_clients = yes

# ============================================================
# 接收限制
# ============================================================
smtpd_recipient_restrictions =
    permit_mynetworks
    permit_sasl_authenticated
    check_client_access cidr:/etc/postfix/dn42_whitelist.cidr
    reject_unauth_destination
    reject_non_fqdn_sender
    reject_non_fqdn_recipient
    reject_unknown_sender_domain
    reject_unknown_recipient_domain

smtpd_helo_required = yes
smtpd_helo_restrictions =
    permit_mynetworks
    permit_sasl_authenticated
    reject_invalid_helo_hostname

# ============================================================
# DN42 传输通道
# ============================================================
transport_maps = hash:/etc/postfix/transport

# ============================================================
# 大小限制
# ============================================================
message_size_limit = 52428800  # 50MB
mailbox_size_limit = 1073741824  # 1GB

# ============================================================
# 反垃圾（Rspamd）
# ============================================================
smtpd_milters = inet:127.0.0.1:11332
non_smtpd_milters = inet:127.0.0.1:11332
milter_default_action = accept
milter_protocol = 6

# ============================================================
# 日志
# ============================================================
syslog_name = postfix
